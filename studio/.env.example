# Required: real Voicecan Device Platform Application configuration.
VOICECAN_SERVER_URL=
VOICECAN_APPLICATION_TOKEN=
VOICECAN_WEBHOOK_SECRET=
VOICECAN_WEBHOOK_SECRET_NEXT=
DEMO_DATABASE_PATH=./data/studio/studio.sqlite
DEMO_CONFIG_PATH=./data/studio/config.json
DEMO_WORK_DIR=./work/studio
# External profile: required real HTTP ASR processor.
PROCESSOR_KIND=http
PROCESSOR_ENDPOINT=http://127.0.0.1:9001
PROCESSOR_API_KEY=
# External profile: required real HTTP Summary Processor.
SUMMARY_ENDPOINT=http://127.0.0.1:9002
SUMMARY_API_KEY=
SUMMARY_MODEL=configured-model
SUMMARY_PROMPT_VERSION=meeting-v2-schema
# Local Full: the delivery must include a pre-registered CTranslate2 model
# at this path. Its repository/revision are read from voicecan-model-manifest.json.
LOCAL_ASR_MODEL_PATH=./models/faster-whisper-small
# Optional. The platform-specific .venv Python is selected automatically.
LOCAL_ASR_PYTHON=
LOCAL_ASR_WORKER=./local-asr/worker.py
# auto explicitly prefers CUDA and falls back to CPU when CUDA initialization fails.
LOCAL_ASR_DEVICE=auto
LOCAL_ASR_COMPUTE_TYPE=default
LOCAL_ASR_CPU_THREADS=0
LOCAL_ASR_TIMEOUT_MS=7200000
# Local Full Summary model, pinned by scripts/install-local-summary-model.py.
LOCAL_SUMMARY_MODEL_PATH=./models/qwen3-4b-q4-k-m
LOCAL_SUMMARY_PYTHON=
LOCAL_SUMMARY_WORKER=./local-summary/worker.py
# prefer offloads every layer when the llama.cpp runtime has a GPU backend,
# then falls back to CPU. Use require to reject CPU fallback, or cpu to disable GPU.
LOCAL_SUMMARY_GPU_MODE=prefer
LOCAL_SUMMARY_GPU_LAYERS=-1
LOCAL_SUMMARY_CONTEXT_SIZE=8192
LOCAL_SUMMARY_MAX_TOKENS=1024
LOCAL_SUMMARY_MAX_CHUNK_SEGMENTS=100
LOCAL_SUMMARY_MAX_CHUNK_CHARACTERS=6000
LOCAL_SUMMARY_TIMEOUT_MS=7200000
# Notification egress is disabled by default in both profiles.
NOTIFICATION_ENABLED=false
COURIER_API_KEY=
COURIER_BASE_URL=https://api.courier.com
STUDIO_PUBLIC_URL=
RESULT_RETENTION_DAYS=30
FFMPEG_PATH=ffmpeg
LC3_DECODER_PATH=dlc3
# Optional overrides. When omitted, External uses 127.0.0.1:8811 and Local
# Full uses 127.0.0.1:8815.
# PORT=8811
# HOST=127.0.0.1
DEMO_SETUP_TOKEN=
DEMO_OPERATOR_TOKEN=
DEMO_ALLOWED_HOSTS=
DEMO_ALLOWED_ORIGINS=
